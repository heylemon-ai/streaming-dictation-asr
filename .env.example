# Copy to .env and fill in only the engines you want to run.
# The runner skips any engine whose keys are missing.

# Gemini Live API
GEMINI_API_KEY=

# Meta Muse Voice Transcribe
META_MODEL_API_KEY=
# META_ASR_MODEL=muse-voice-transcribe-1.0

# Whisper and Qwen3-ASR deployments on Baseten
BASETEN_API_KEY=
# gated Whisper (whisper) and self-hosted Whisper (whisper-self-hosted*)
BASETEN_WHISPER_MODEL_ID=
BASETEN_WHISPER_SELF_HOSTED_MODEL_ID=
BASETEN_QWEN_MODEL_ID=

# Engines defined in config/engines/ (generic adapters)
DEEPGRAM_API_KEY=
# OpenAI: GPT-Live, RT Whisper, Whisper-1
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ZOOM_SCRIBE_STT_MODEL_KEY=
RIME_API_KEY=

# AssemblyAI (config engines assemblyai-3-5-pro, assemblyai-3-6-pro)
ASSEMBLY_AI_API_KEY=
