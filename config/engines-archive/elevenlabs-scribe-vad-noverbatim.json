{
  "$comment": "ARCHIVED, not loaded (config/engines-archive/). A 2026-10-14 attempt at dictation settings: no_verbatim=true with VAD commits (0.3 s silence). Not reported, for two reasons found after the run: (1) with VAD commits nothing is left to commit when the audio ends, so the end-of-clip signal (an empty committed_transcript) arrived ~15 s late, inflating latency and letting the idle session add phantom text; (2) no_verbatim rewrote Najdi dialect into Modern Standard Arabic. Its raw results remain in the local cache under its original id.",
  "id": "elevenlabs-scribe-vad-noverbatim",
  "label": "ElevenLabs Scribe v2 Realtime",
  "kind": "websocket",
  "model": "scribe_v2_realtime",
  "env": [
    "ELEVENLABS_API_KEY"
  ],
  "sampleRate": 16000,
  "languages": {
    "en": "en",
    "ar": "ar",
    "de": "de",
    "es": "es",
    "fr": "fr",
    "hi": "hi",
    "ur": "ur",
    "zh": "zh"
  },
  "url": "wss://api.elevenlabs.io/v1/speech-to-text/realtime?model_id=${model}&audio_format=pcm_16000&commit_strategy=vad&vad_silence_threshold_secs=0.3&no_verbatim=true&language_code=${primary_language}&secondary_languages=${secondary_language}",
  "headers": {
    "xi-api-key": "${env:ELEVENLABS_API_KEY}"
  },
  "readyOn": {
    "message_type": "session_started"
  },
  "audio": {
    "message_type": "input_audio_chunk",
    "audio_base_64": "${audio_base64}",
    "commit": false,
    "sample_rate": 16000
  },
  "end": {
    "message_type": "input_audio_chunk",
    "audio_base_64": "",
    "commit": true,
    "sample_rate": 16000
  },
  "final": {
    "match": {
      "message_type": "committed_transcript"
    },
    "textPath": "text"
  },
  "done": {
    "match": {
      "message_type": "committed_transcript",
      "text": ""
    },
    "onClose": true
  },
  "error": {
    "match": {
      "message_type": [
        "error",
        "auth_error",
        "quota_exceeded",
        "commit_throttled",
        "unaccepted_terms",
        "rate_limited",
        "queue_overflow",
        "resource_exhausted",
        "session_time_limit_exceeded",
        "input_error",
        "invalid_request",
        "chunk_size_exceeded",
        "insufficient_audio_activity",
        "transcriber_error"
      ]
    },
    "messagePath": "error"
  }
}