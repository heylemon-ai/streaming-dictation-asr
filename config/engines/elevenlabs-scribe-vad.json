{
  "$comment": "Two-language test only (not used for latency). As elevenlabs-scribe, but committing at each pause (commit_strategy=vad, 0.3 s silence, at the 300 ms gap that joins the two clips) instead of once when the audio ends. Every committed_transcript is kept; the clip ends on an empty commit or 3 s with no new text after the audio ends, because with VAD commits nothing may be left to commit at the end (a refused final commit is then not an error) (see config/engines-archive/). Added 2026-10-29 after a 40-recording trial cut lost languages from 22 to 8.",
  "id": "elevenlabs-scribe-vad",
  "label": "ElevenLabs Scribe v2 Realtime (commit at pauses)",
  "kind": "websocket",
  "model": "scribe_v2_realtime",
  "env": [
    "ELEVENLABS_API_KEY"
  ],
  "sampleRate": 16000,
  "languages": {
    "en": "en",
    "ar": "ar",
    "de": "de",
    "es": "es",
    "fr": "fr",
    "hi": "hi",
    "ur": "ur",
    "zh": "zh"
  },
  "url": "wss://api.elevenlabs.io/v1/speech-to-text/realtime?model_id=${model}&audio_format=pcm_16000&commit_strategy=vad&vad_silence_threshold_secs=0.3&language_code=${primary_language}&secondary_languages=${secondary_language}",
  "headers": {
    "xi-api-key": "${env:ELEVENLABS_API_KEY}"
  },
  "readyOn": {
    "message_type": "session_started"
  },
  "audio": {
    "message_type": "input_audio_chunk",
    "audio_base_64": "${audio_base64}",
    "commit": false,
    "sample_rate": 16000
  },
  "end": {
    "message_type": "input_audio_chunk",
    "audio_base_64": "",
    "commit": true,
    "sample_rate": 16000
  },
  "final": {
    "match": {
      "message_type": "committed_transcript"
    },
    "textPath": "text"
  },
  "done": {
    "match": {
      "message_type": "committed_transcript",
      "text": ""
    },
    "onClose": true,
    "quietMsAfterEnd": 3000
  },
  "error": {
    "match": {
      "message_type": [
        "error",
        "auth_error",
        "quota_exceeded",
        "commit_throttled",
        "unaccepted_terms",
        "rate_limited",
        "queue_overflow",
        "resource_exhausted",
        "session_time_limit_exceeded",
        "input_error",
        "invalid_request",
        "chunk_size_exceeded",
        "insufficient_audio_activity",
        "transcriber_error"
      ]
    },
    "messagePath": "error",
    "ignore": [
      "Commit request ignored"
    ]
  }
}
